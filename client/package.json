{
  "name": "ameyka-ecommerce-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo.mjs --public",
    "build": "vite build && node scripts/generate-seo.mjs --dist",
    "preview": "vite preview",
    "check:source": "node scripts/check-project.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run check:source && npm test && npm run build && npm run check:seo"
  },
  "dependencies": {
    "lucide-react": "1.21.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.5.0",
    "postcss": "8.5.15",
    "tailwindcss": "3.4.19",
    "vite": "5.4.21"
  }
}
